{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stargate-orionis.local/schemas/technical-requirements.schema.json",
  "title": "Theory and Recipe Technical Requirements",
  "description": "Separate technical Room Service requirements. These do not create Room Processing Capabilities.",
  "type": "object",
  "patternProperties": {
    "^[A-Z][A-Z0-9_]*$": {"$ref": "#/$defs/requirementSet"}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "requirement": {
      "type": "object",
      "required": ["roomService"],
      "additionalProperties": false,
      "properties": {
        "bubbleId": {"$ref": "#/$defs/identifier"},
        "context": {"$ref": "#/$defs/identifier"},
        "roomService": {"$ref": "#/$defs/identifier"}
      },
      "oneOf": [{"required": ["bubbleId"]}, {"required": ["context"]}]
    },
    "requirementSet": {
      "type": "object",
      "required": ["id", "requirements"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}