    { "inv": 20, "conversionStat": 1230, "family": "SUPPLY", "tiers": [1, 2], "policy": "QUANTITY", "outputs": { "S1": 184, "S2": 15 } },
    { "inv": 20, "conversionStat": 1230, "family": "SUPPLY", "tiers": [1, 2], "policy": "BALANCED", "outputs": { "S1": 123, "S2": 30 } },
    { "inv": 20, "conversionStat": 1230, "family": "SUPPLY", "tiers": [1, 2], "policy": "QUALITY", "outputs": { "S1": 61, "S2": 46 } }
  ]
