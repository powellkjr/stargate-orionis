{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stargate-orionis.local/schemas/item.schema.json",
  "title": "Stargate Orionis Item Table",
  "description": "Schema for reusable item definitions. Cross-table references to theories and storage services are validated separately.",
  "type": "object",
  "patternProperties": {
    "^[A-Z][A-Z0-9_]*$": {
      "$ref": "#/$defs/item"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "identifierArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "tags",
        "storage",
        "processCompatibility",
        "theoryBindings",
        "materials"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "ITEM"
        },
        "tags": {
          "$ref": "#/$defs/identifierArray",
          "description": "Authored Reality tags for the item definition, not automatically Known Tags on a recovered instance."
        },
        "storage": {
          "$ref": "#/$defs/storage"
        },
        "processCompatibility": {
          "$ref": "#/$defs/processCompatibility",
          "description": "Item-kind process compatibility only. Does not establish an instance processing requirement, authorization, active state, or completion."
        },
        "theoryBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/theoryBinding"
          }
        },
        "family": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "civilization": {
              "$ref": "#/$defs/identifier"
            },
            "formFactor": {
              "$ref": "#/$defs/identifier"
            },
            "subjectTags": {
              "$ref": "#/$defs/identifierArray"
            }
          }
        },
        "physical": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inventoryClass": {
              "$ref": "#/$defs/identifier"
            },
            "isContainer": {
              "type": "boolean"
            },
            "isTool": {
              "type": "boolean"
            }
          }
        },
        "possibleReality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inherentTags": {
              "$ref": "#/$defs/identifierArray"
            },
            "possibleTags": {
              "$ref": "#/$defs/identifierArray"
            }
          }
        },
        "processingExposure": {
          "$ref": "#/$defs/processingExposure",
          "description": "Authored room-specific Knowledge exposure. It does not change Reality or institutional Knowledge."
        },
        "nameResolution": {
          "$ref": "#/$defs/nameResolution",
          "description": "Authored display labels applied when a process exits. These labels are presentation and do not independently grant Knowledge."
        },
        "salvageGuidance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preserveMass": {
              "type": "boolean"
            }
          }
        },
        "extension": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ordinaryAsgardPatternsAreImplicitInFabricationCapability": {
              "type": "boolean"
            },
            "sourceRecipeId": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "materials": {
          "$ref": "#/$defs/materials",
          "description": "Authored construction and destructive-salvage material economics. Independent of storage.storageClasses and all Reality, Known, and Processing Tags."
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "storageClasses",
        "handlingCost",
        "isUnique",
        "isStackable",
        "isCargo"
      ],
      "additionalProperties": false,
      "properties": {
        "storageClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "handlingCost": {
          "type": "integer",
          "minimum": 0
        },
        "isUnique": {
          "type": "boolean"
        },
        "isStackable": {
          "type": "boolean"
        },
        "isCargo": {
          "type": "boolean"
        }
      }
    },
    "materials": {
      "type": "object",
      "required": [
        "baseCost",
        "materialClass"
      ],
      "additionalProperties": false,
      "properties": {
        "baseCost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Fixed-point base construction cost. 123 represents 12.3 cost units, using the same 0-1000 convention as percentOfWhole."
        },
        "materialClass": {
          "type": "string",
          "enum": [
            "M1",
            "M2",
            "M3",
            "S1",
            "S2",
            "S3",
            "RATION",
            "KNOWLEDGE"
          ],
          "description": "Authored material resource classification used by construction and destructive salvage."
        }
      }
    },
    "processCompatibility": {
      "type": "object",
      "required": [
        "receiving",
        "analysis",
        "construction",
        "repair",
        "reverseEngineering",
        "salvage"
      ],
      "additionalProperties": false,
      "properties": {
        "receiving": {
          "type": "boolean"
        },
        "analysis": {
          "type": "boolean"
        },
        "construction": {
          "type": "boolean"
        },
        "repair": {
          "type": "boolean"
        },
        "reverseEngineering": {
          "type": "boolean"
        },
        "salvage": {
          "type": "boolean"
        }
      }
    },
    "theoryBinding": {
      "type": "object",
      "required": [
        "theoryId",
        "implementedProperties"
      ],
      "additionalProperties": false,
      "properties": {
        "theoryId": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "implementedProperties": {
          "$ref": "#/$defs/identifierArray"
        },
        "implementationTags": {
          "$ref": "#/$defs/identifierArray"
        }
      }
    }
    ,"processingExposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receiving": {"$ref": "#/$defs/receivingExposure"},
        "analysis": {"$ref": "#/$defs/analysisExposure"}
      }
    },
    "receivingExposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identityTags": {"$ref": "#/$defs/identifierArray"},
        "conditionTags": {"$ref": "#/$defs/identifierArray"}
      }
    },
    "analysisExposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orderedFunctionalityTags": {"$ref": "#/$defs/identifierArray"}
      }
    },
    "nameResolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialName": {"type": "string", "minLength": 1},
        "processExitNames": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "receiving": {"type": "string", "minLength": 1},
            "analysis": {"type": "string", "minLength": 1},
            "workshop": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
