{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stargate-orionis.local/schemas/base-tile.schema.json",
  "title": "Stargate Orionis Base Tile Entry",
  "description": "Authoring schema for non-room underground base tiles such as rock, excavated space, voids, and geological blockers.",
  "type": "object",
  "required": ["identity", "form", "rules", "function"],
  "additionalProperties": false,
  "properties": {
    "identity": {
      "type": "object",
      "required": ["id", "name", "category"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1}
      }
    },
    "form": {
      "type": "object",
      "required": ["footprint", "renderFamily"],
      "additionalProperties": false,
      "properties": {
        "footprint": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        },
        "renderFamily": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "supportsDamageVariants": {"type": "boolean"},
        "supportsConstructionVariants": {"type": "boolean"}
      }
    },
    "rules": {
      "type": "object",
      "required": ["excavation", "construction", "visibility", "geology"],
      "additionalProperties": false,
      "properties": {
        "excavation": {"$ref": "#/$defs/excavationRule"},
        "construction": {"$ref": "#/$defs/constructionRule"},
        "visibility": {"$ref": "#/$defs/visibilityRule"},
        "geology": {"$ref": "#/$defs/geologyRule"}
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "base": {"type": "string"},
        "transitionOnExcavate": {"type": "string"},
        "transitionOnRemoveRoom": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "shellFamily": {"type": "string"},
        "mountainContext": {"type": "boolean"},
        "circulationMargin": {"type": "string"},
        "promptNotes": {"type": "string"}
      }
    }
  },
  "$defs": {
    "notesString": {"type": "string", "minLength": 1},
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "excavationRule": {
      "type": "object",
      "required": ["supportsExcavation", "notes"],
      "additionalProperties": true,
      "properties": {
        "supportsExcavation": {"type": "boolean"},
        "yieldTypes": {"$ref": "#/$defs/stringArray"},
        "yieldRange": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": {
            "min": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 0}
          }
        },
        "notes": {"$ref": "#/$defs/notesString"}
      }
    },
    "constructionRule": {
      "type": "object",
      "required": ["supportsPlacement", "supportsRoomConstruction", "notes"],
      "additionalProperties": true,
      "properties": {
        "supportsPlacement": {"type": "boolean"},
        "supportsRoomConstruction": {"type": "boolean"},
        "blocksConstruction": {"type": "boolean"},
        "notes": {"$ref": "#/$defs/notesString"}
      }
    },
    "visibilityRule": {
      "type": "object",
      "required": ["supportsFogOfWar", "notes"],
      "additionalProperties": true,
      "properties": {
        "supportsFogOfWar": {"type": "boolean"},
        "revealBehavior": {"type": "string", "minLength": 1},
        "notes": {"$ref": "#/$defs/notesString"}
      }
    },
    "geologyRule": {
      "type": "object",
      "required": ["geologyType", "notes"],
      "additionalProperties": true,
      "properties": {
        "geologyType": {"type": "string", "minLength": 1},
        "hardnessTier": {"type": "integer", "minimum": 0},
        "supportsEvents": {"type": "boolean"},
        "eventFamilies": {"$ref": "#/$defs/stringArray"},
        "notes": {"$ref": "#/$defs/notesString"}
      }
    }
  }
}