{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stargate-orionis.local/schemas/instance.schema.json",
  "title": "Stargate Orionis Instance Table",
  "description": "Schema for persistent physical instances. The table is keyed by instanceId; cross-table references are validated separately.",
  "type": "object",
  "patternProperties": {
    "^[A-Z][A-Z0-9_]*$": {
      "$ref": "#/$defs/instance"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "instance": {
      "type": "object",
      "required": [
        "instanceId",
        "itemId",
        "state",
        "reality",
        "knowledge",
        "custody",
        "processes",
        "history"
      ],
      "additionalProperties": false,
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "itemId": {
          "$ref": "#/$defs/identifier"
        },
        "state": {
          "$ref": "#/$defs/physicalState"
        },
        "reality": {
          "$ref": "#/$defs/reality"
        },
        "knowledge": {
          "$ref": "#/$defs/knowledge"
        },
        "custody": {
          "$ref": "#/$defs/custody"
        },
        "processes": {
          "$ref": "#/$defs/processes"
        },
        "history": {
          "$ref": "#/$defs/history"
        },
        "relationships": {
          "$ref": "#/$defs/relationships"
        },
        "processingTags": {
          "$ref": "#/$defs/processingTags"
        }
      }
    },
    "physicalState": {
      "type": "object",
      "required": [
        "condition",
        "functionalState",
        "quantity",
        "percentOfWhole"
      ],
      "additionalProperties": false,
      "properties": {
        "condition": {
          "enum": [
            "UNKNOWN",
            "INTACT",
            "DAMAGED",
            "DESTROYED"
          ],
          "description": "UNKNOWN is valid before Receiving establishes condition. Condition remains structured Physical State, not a Processing Tag."
        },
        "functionalState": {
          "enum": [
            "FUNCTIONAL",
            "DEGRADED",
            "NONFUNCTIONAL",
            "UNKNOWN"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "percentOfWhole": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "powerState": {
          "$ref": "#/$defs/identifier"
        },
        "constructionState": {
          "$ref": "#/$defs/identifier"
        },
        "damage": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "description": "Physical condition, functional state, and quantity, with existing physical fields retained. Processing permission and completion belong in processingTags/processes."
    },
    "theoryBinding": {
      "type": "object",
      "required": [
        "theoryId",
        "implementedProperties"
      ],
      "additionalProperties": false,
      "properties": {
        "theoryId": {
          "$ref": "#/$defs/identifier"
        },
        "implementedProperties": {
          "$ref": "#/$defs/stringArray"
        },
        "implementationTags": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "reality": {
      "type": "object",
      "required": [
        "theoryBindings",
        "authoredTags"
      ],
      "additionalProperties": false,
      "properties": {
        "theoryBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/theoryBinding"
          }
        },
        "authoredTags": {
          "$ref": "#/$defs/stringArray",
          "description": "Reality Tags initialized from authored Item Definition truth. Learning does not mutate these tags; physical transitions remain distinct from recognition."
        },
        "technology": {
          "$ref": "#/$defs/stringArray"
        },
        "implementationPatterns": {
          "$ref": "#/$defs/stringArray"
        },
        "fabricationEcosystem": {
          "$ref": "#/$defs/stringArray"
        },
        "materials": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "instanceFinding": {
      "type": "object",
      "required": [
        "id",
        "type",
        "claim",
        "scope",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "INSTANCE_FINDING"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "INSTANCE"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "relatedTheory": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "required": [
        "revealedTags"
      ],
      "additionalProperties": false,
      "properties": {
        "revealedTags": {
          "$ref": "#/$defs/stringArray",
          "description": "Known Tags: instance recognition/interpretation derived from retained evidence and current SGC Theory/Pattern Knowledge. Re-evaluate when relevant institutional Knowledge changes; do not reveal Reality merely because its definition is loaded."
        },
        "identityTags": {"$ref": "#/$defs/stringArray"},
        "conditionTags": {"$ref": "#/$defs/stringArray"},
        "functionalityTags": {"$ref": "#/$defs/stringArray"},
        "instanceFindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instanceFinding"
          }
        },
        "recognizedIdentity": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "recognizedCivilization": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "recognizedItemClass": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "handlingKnowledge": {
          "$ref": "#/$defs/stringArray"
        },
        "knownProcessRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "process": {
                "$ref": "#/$defs/identifier"
              },
              "knowledgeRequirements": {
                "$ref": "#/$defs/stringArray"
              }
            },
            "required": [
              "process",
              "knowledgeRequirements"
            ]
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "unitCost",
        "extendedCost"
      ],
      "additionalProperties": false,
      "properties": {
        "unitCost": {
          "type": "integer",
          "minimum": 0
        },
        "extendedCost": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "custody": {
      "type": "object",
      "required": [
        "storageId",
        "containerId",
        "leaseId",
        "state",
        "nextStorageId",
        "status",
        "reservedBy",
        "committedBy",
        "cost"
      ],
      "additionalProperties": false,
      "properties": {
        "storageId": {
          "$ref": "#/$defs/identifier"
        },
        "containerId": {
          "$ref": "#/$defs/identifier"
        },
        "leaseId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "ACTIVE",
            "INACTIVE",
            "DROPPED",
            "LOST",
            "EQUIPPED",
            "STANDBY"
          ]
        },
        "nextStorageId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "STORED",
            "IN_TRANSIT",
            "INBOUND",
            "OUTBOUND",
            "DELIVERED",
            "PENDING_STORAGE"
          ]
        },
        "reservedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "committedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost": {
          "$ref": "#/$defs/cost"
        }
      },
      "description": "Physical location and custody claims. containerId identifies the current physical location; custody alone does not authorize processing."
    },
    "process": {
      "type": "object",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "COMPLETE",
            "BLOCKED",
            "CANCELLED"
          ]
        },
        "recipeId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "completedBubbles": {
          "$ref": "#/$defs/stringArray"
        },
        "currentBubble": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "partialProgress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "findingsProduced": {
          "$ref": "#/$defs/stringArray"
        },
        "completedSteps": {
          "$ref": "#/$defs/stringArray"
        },
        "currentStep": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "processes": {
      "type": "object",
      "required": [
        "receiving",
        "analysis",
        "reverseEngineering",
        "salvage"
      ],
      "additionalProperties": false,
      "properties": {
        "receiving": {
          "$ref": "#/$defs/process"
        },
        "analysis": {
          "$ref": "#/$defs/process"
        },
        "construction": {
          "$ref": "#/$defs/process"
        },
        "repair": {
          "$ref": "#/$defs/process"
        },
        "reverseEngineering": {
          "$ref": "#/$defs/process"
        },
        "salvage": {
          "$ref": "#/$defs/process"
        }
      }
    },
    "historyEvent": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "$ref": "#/$defs/identifier"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "history": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/historyEvent"
          },
          {
            "$ref": "#/$defs/authoredHistoryEvent"
          }
        ]
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parentInstanceId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "childInstanceIds": {
          "$ref": "#/$defs/stringArray"
        },
        "createdFrom": {
          "$ref": "#/$defs/stringArray"
        },
        "sourceRecipeId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "derivedKnowledge": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "authoredHistoryEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "location": {
          "$ref": "#/$defs/identifier"
        },
        "recipeId": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "event"
      ],
      "description": "Authored fixture event without a runtime timestamp; retained without inventing a timestamp or actor."
    },
    "processingTags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "description": "Flat array of authored processing tag IDs, including requirements, authorization, identity, availability, selection, active processing, and completion. Contracts define prerequisites and tag additions/removals. Optional during migration; absence does not grant permission. Detailed execution remains in processes and location in custody. Runtime must not invent canonical tags."
    }
  }
}
