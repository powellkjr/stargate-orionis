  "dialogueScenes": [
    {
      "dialogueSceneId": "relay-dialogue-arrival",
      "participants": {
        "left": "ACTIVE_SGC_SPEAKER",
        "right": "relay-rhel-01"
      },
      "startWhen": {
        "stageVisitCount": {
          "stageId": "relay-courtyard",
          "equals": 1
        }
      },
      "startNodeId": "arrival-opening",
      "nodes": [
        {
          "nodeId": "arrival-opening",
          "speaker": "relay-rhel-01",
          "side": "RIGHT",
          "text": "Hold there. Commander Rhel, salvage crew. This station was deserted when we arrived. If you have questions, speak to me before disturbing our work.",
          "responses": [
            {
              "responseId": "arrival-acknowledge",
              "text": "We received a distress call. We will speak with you and check the station.",
              "source": "NEUTRAL",
              "endConversation": true
            }
          ]
        }
      ]
    },
    {
      "dialogueSceneId": "relay-dialogue-rhel",
      "participants": {
        "left": "ACTIVE_SGC_SPEAKER",
        "right": "relay-rhel-01"
      },
      "startNodeId": "rhel-opening",
      "nodes": [
        {
          "nodeId": "rhel-opening",
          "speaker": "relay-rhel-01",
          "side": "RIGHT",
          "text": "Commander Rhel. This relay was deserted when we arrived. We are salvaging it. You may look around, but keep out of our business and leave when you are done.",
          "responses": [
            {
              "responseId": "rhel-investigate",
              "text": "We received a distress call. We will check the station before leaving.",
              "source": "NEUTRAL",
              "nextNodeId": "rhel-watch"
            },
            {
              "responseId": "rhel-negotiate",
              "text": "Our task is a rescue. Withdraw your crew from the approach and we will leave your salvage claim for others to settle.",
              "source": "DIPLOMAT",
              "requirements": {
                "profession": "DIPLOMAT",
                "minimumTier": 1
              },
              "nextNodeId": "rhel-withdraw"
            },
            {
              "responseId": "rhel-evidence",
              "text": "The log records a distress call before your crew locked the generator room. There are survivors. Clear the route and let us evacuate them.",
              "source": "KNOWLEDGE",
              "requirements": {
                "knowledge": "relay-lock-command-recorded"
              },
              "nextNodeId": "rhel-admit"
            },
            {
              "responseId": "rhel-force",
              "text": "If you intend to hold these people here, we will take the station by force.",
              "source": "SOLDIER",
              "requirements": {
                "profession": "SOLDIER",
                "minimumTier": 1
              },
              "nextNodeId": "rhel-fight"
            }
          ]
        },
        {
          "nodeId": "rhel-watch",
          "speaker": "relay-rhel-01",
          "side": "RIGHT",
          "text": "Check your signal, then go. The service door is locked; I am not handing over the station's codes.",
          "endConversation": true
        },
        {
          "nodeId": "rhel-withdraw",
          "speaker": "relay-rhel-01",
          "side": "RIGHT",
          "text": "Fine. We will withdraw from the courtyard and approach. Take the survivors. This is an evacuation agreement, not a surrender or a transfer of the station.",
          "effects": [
            {
              "type": "ADD_KNOWLEDGE",
              "knowledgeId": "relay-crew-withdrawal-agreed"
            }
          ],
          "endConversation": true
        },
        {
          "nodeId": "rhel-admit",
          "speaker": "relay-rhel-01",
          "side": "RIGHT",
          "text": "We locked the service door to stop anyone interfering with salvage. I did not check behind it. We will withdraw. Get them out.",
          "effects": [
            {
              "type": "ADD_KNOWLEDGE",
              "knowledgeId": "relay-crew-withdrawal-agreed"
            }
          ],
          "endConversation": true
        },
        {
          "nodeId": "rhel-fight",
          "speaker": "relay-rhel-01",
          "side": "RIGHT",
          "text": "You are not taking this station from us. Crew, weapons up!",
          "effects": [
            {
              "type": "START_HOSTILE_INCIDENT",
              "incidentId": "relay-crew-combat"
            }
          ],
          "endConversation": true
        }
      ]
    },
    {
      "dialogueSceneId": "relay-dialogue-taren",
      "participants": {
        "left": "ACTIVE_SGC_SPEAKER",
        "right": "relay-taren-01"
      },
      "startNodeId": "taren-opening",
      "nodes": [
        {
          "nodeId": "taren-opening",
          "speaker": "relay-taren-01",
          "side": "RIGHT",
          "text": "I am Taren. I sent the distress call. Vessa, our engineer, is trapped in the generator room. Its service code is 7314. I need treatment, but I will not leave until Vessa is safely at the Gate. The transmission log can verify my call.",
          "effects": [
            {
              "type": "ADD_KNOWLEDGE",
              "knowledgeId": "relay-taren-contacted"
            },
            {
              "type": "ADD_KNOWLEDGE",
              "knowledgeId": "relay-service-code-known"
            },
            {
              "type": "SET_DETECTION_STATE",
              "instanceId": "relay-taren-01",
              "value": "LOCATED"
            },
            {
              "type": "ACTIVATE_OBJECTIVE",
              "objectiveId": "relay-rescue-vessa"
            }
          ],
          "responses": [
            {
              "responseId": "taren-plan",
              "text": "We will treat your injury, free Vessa and make a safe route back. Wait here until your colleague reaches the Gate.",
              "source": "NEUTRAL",
              "effects": [
                {
                  "type": "SET_EVAC_STATE",
                  "instanceId": "relay-taren-01",
                  "value": "READY_TO_EVACUATE"
                }
              ],
              "nextNodeId": "taren-wait"
            }
          ]
        },
        {
          "nodeId": "taren-wait",
          "speaker": "relay-taren-01",
          "side": "RIGHT",
          "text": "Thank you. Stabilize my injury before I move. If Rhel will not withdraw, you will have to clear his crew from the route.",
          "endConversation": true
        }
      ]
    },
    {
      "dialogueSceneId": "relay-dialogue-vessa",
      "participants": {
        "left": "ACTIVE_SGC_SPEAKER",
        "right": "relay-vessa-01"
      },
      "startNodeId": "vessa-opening",
      "nodes": [
        {
          "nodeId": "vessa-opening",
          "speaker": "relay-vessa-01",
          "side": "RIGHT",
          "text": "I am Vessa. Rhel's crew sealed the service door while I was working here. Taren kept the relay powered long enough to send the call. I can walk. Please do not leave Taren behind.",
          "effects": [
            {
              "type": "ADD_KNOWLEDGE",
              "knowledgeId": "relay-vessa-contacted"
            },
            {
              "type": "SET_DETECTION_STATE",
              "instanceId": "relay-vessa-01",
              "value": "LOCATED"
            },
            {
              "type": "ACTIVATE_OBJECTIVE",
              "objectiveId": "relay-rescue-vessa"
            }
          ],
          "responses": [
            {
              "responseId": "vessa-plan",
              "text": "We will send you to the Gate along the cleared route, then return for Taren.",
              "source": "NEUTRAL",
              "effects": [
                {
                  "type": "SET_EVAC_STATE",
                  "instanceId": "relay-vessa-01",
                  "value": "READY_TO_EVACUATE"
                }
              ],
              "nextNodeId": "vessa-ready"
            }
          ]
        },
        {
          "nodeId": "vessa-ready",
          "speaker": "relay-vessa-01",
          "side": "RIGHT",
          "text": "I will wait until you confirm the route is safe, then meet you at the Gate.",
          "endConversation": true
        }
      ]
    }
  ],
