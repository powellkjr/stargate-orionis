      "type": "HAVEN_REQUEST",
      "relationship": "ALLIED",
      "request": "Investigate a distress call from a mountain relay station using an old allied recognition code."
    },
    "destinationId": "mountain-relay-001",
    "seed": 271828,
    "briefing": {
      "playerText": "A distress call using an old allied recognition code has reached the SGC from a remote mountain relay station. Find the caller, verify the signal, and evacuate anyone who needs help. An armed salvage crew is reported nearby. Recommended team: Medic I with a medical kit, Technician I with a technical kit, Diplomat I, and Soldier. A Technician II kit offers an alternate route through the generator-room lock. Recover the transmission log if possible. No manufacturing Patterns or scientific Theories are expected as mission rewards.",
      "specialIntel": [
        "relay-allied-recognition-code-known"
      ]
    }
  },
